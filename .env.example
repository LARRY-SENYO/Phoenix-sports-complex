# Server Security Configuration
PORT=3000
NODE_ENV=development

# Cryptographic Pepper Secret (STORED EXCLUSIVELY ON SERVER, NEVER IN DATABASE)
PEPPER_SECRET=replace_with_a_secure_random_64_character_hex_pepper_secret

# JWT Secret for Signed Session Tokens
JWT_SECRET=replace_with_a_secure_jwt_secret_key

# 2FA Settings
TOTP_ISSUER=TitanSports
TOTP_WINDOW_STEPS=1
